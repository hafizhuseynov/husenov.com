---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="site-shell">
			<div class="site">
			<Header showBio />
			<main id="main-content">
				<section aria-labelledby="writing-heading">
					<div class="section-bar">
						<span id="writing-heading">Writing</span>
						<a href="/blog" style="display: inline-flex; align-items: center; gap: 4px;">
							<span>all posts</span>
							<svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24">
								<path d="M0 0h24v24H0z" fill="none" />
								<path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10m0 0v10m0-10L7 17" />
							</svg>
						</a>
					</div>
					<ul class="post-list">
						{
							posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span class="post-title">{post.data.title}</span>
										<span class="post-date">
											<FormattedDate date={post.data.pubDate} format="monthYear" />
										</span>
									</a>
								</li>
							))
						}
					</ul>
				</section>
			</main>
			</div>
		</div>
	</body>
</html>
