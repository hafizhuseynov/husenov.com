---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description="About Hafiz" />
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="site-shell">
			<div class="site">
				<Header />
				<main id="main-content">
					<section class="content-section" aria-labelledby="why-heading">
						<div class="section-bar">
							<span id="why-heading">Why this site exists</span>
						</div>
						<div class="section-body section-body--lead">
							<p>I'm better when I write.</p>
							<p>Writing forces me to actually understand what I think I know.</p>
						</div>
					</section>

					<section class="content-section" aria-labelledby="philosophy-heading">
						<div class="section-bar">
							<span id="philosophy-heading">About</span>
						</div>
						<div class="section-body section-body--muted">
							<p>
								I'm Hafiz, a web developer based in Baku, Azerbaijan. Self-taught, which means every
								concept I know I had to find, break, and rebuild myself.
							</p>
							<p>
								My math teacher once told me: never memorize a formula — learn its proof. That stuck.
								When I hit an error I don't understand, I don't move on until I know exactly why it
								happened.
							</p>
							<p>
								I try to stay a beginner on purpose, because the moment you think you know enough,
								you stop looking.
							</p>
						</div>
					</section>
				</main>
			</div>
		</div>
	</body>
</html>
