---
const today = new Date();
---

<footer class="site-footer">
	<p>&copy; {today.getFullYear()} Hafiz</p>
</footer>

<style>
	.site-footer {
		padding: var(--space-lg) 0 var(--space-xl);
		border-top: 1px solid var(--border);
	}

	.site-footer p {
		margin: 0;
		font-size: 0.875rem;
		color: var(--text-muted);
	}
</style>
